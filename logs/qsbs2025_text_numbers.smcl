{com}. * The datasets saved by the NEW qsbs2025_replication.do must all be in one folder.
. local need "analysis_sample panel_corp_quarterly panel_main_monthly panel_main_quarterly retiming_weekly"
{txt}
{com}. local found ""
{txt}
{com}. foreach cand in "data/clean" "qsbs2025_stata_package/data/clean" "." {c -(}
{txt}  2{com}.     if "`found'" == "" {c -(}
{txt}  3{com}.         local ok = 1
{txt}  4{com}.         foreach f of local need {c -(}
{txt}  5{com}.             cap confirm file "`cand'/`f'.dta"
{txt}  6{com}.             if _rc != 0 local ok = 0
{txt}  7{com}.         {c )-}
{txt}  8{com}.         if `ok' == 1 local found "`cand'"
{txt}  9{com}.     {c )-}
{txt} 10{com}. {c )-}
{txt}
{com}. di as text "current folder: " c(pwd)
{res}{txt}current folder: C:\Users\user\Downloads\qsbs2025-formd-replication

{com}. if "`found'" == "" {c -(}
.     di as error "The datasets of qsbs2025_replication.do are not all in data/clean of this folder."
.     di as error `"Type   cd "C:\Users\user\Desktop\qsbs2025_stata_package (1)"   (the folder where you ran qsbs2025_replication.do)"'
.     di as error "and run this file again."
.     exit 601
. {c )-}
{txt}
{com}. global D "`found'"
{txt}
{com}. di as text "data folder: $D"
{res}{txt}data folder: data/clean

{com}. * the datasets must come from the current version of qsbs2025_replication.do
. use "$D/analysis_sample.dta", clear
{txt}
{com}. cap confirm variable rev25
{txt}
{com}. local new = (_rc == 0)
{txt}
{com}. qui count if late_rev == 1 & ambig == 0
{txt}
{com}. if `new' == 0 {c -(}
.     di as error "data/clean/analysis_sample.dta comes from an older run of qsbs2025_replication.do."
.     di as error "Run the current qsbs2025_replication.do in this folder first, then this file."
.     exit 459
. {c )-}
{txt}
{com}. di as text "analysis_sample.dta: " r(N) " main-sample offerings with revenue above USD 5 million"
{res}{txt}analysis_sample.dta: 1023 main-sample offerings with revenue above USD 5 million

{com}. 
. * show "label" coefficient t|z : b, se and the p-value the command itself reports
. cap program drop show
{txt}
{com}. program define show
{txt}  1{com}.     args lab v dist
{txt}  2{com}.     local b  = _b[`v']
{txt}  3{com}.     local se = _se[`v']
{txt}  4{com}.     if "`dist'" == "t" local p = 2 * ttail(e(df_r), abs(`b' / `se'))
{txt}  5{com}.     else local p = 2 * normal(-abs(`b' / `se'))
{txt}  6{com}.     di as result %-44s "`lab'" " b = " %10.5f `b' "   se = " %9.5f `se' "   p = " %7.4f `p' "   N = " %7.0f e(N)
{txt}  7{com}. end
{txt}
{com}. 
