. *------------------------------------------------------------------------------*
. * 0. Paths, packages, graph style
. *------------------------------------------------------------------------------*
. di as result _n "===== SECTION 0. Paths, packages, graph style ====="
{res}
===== SECTION 0. Paths, packages, graph style =====
{txt}
{com}. * If you did not -cd- into the package folder, write its path here (keep the quotes):
. global ROOT ""
{txt}
{com}. * example:  global ROOT "C:\Users\user\Downloads\qsbs2025_stata_package"
. if `"$ROOT"' != "" cd `"$ROOT"'
{txt}
{com}. * The package ships the input compressed (data/clean/offerings.zip, GitHub's file-size limit):
. * unzip it once if offerings.dta is not there yet
. foreach cand in "data/clean" "qsbs2025_stata_package/data/clean" "." {c -(}
{txt}  2{com}.     cap confirm file "`cand'/offerings.dta"
{txt}  3{com}.     if _rc != 0 {c -(}
{txt}  4{com}.         cap confirm file "`cand'/offerings.zip"
{txt}  5{com}.         if _rc == 0 {c -(}
{txt}  6{com}.             local here "`c(pwd)'"
{txt}  7{com}.             qui cd "`cand'"
{txt}  8{com}.             di as text "unzipping offerings.zip ..."
{txt}  9{com}.             cap noisily unzipfile "offerings.zip", replace
{txt} 10{com}.             qui cd "`here'"
{txt} 11{com}.         {c )-}
{txt} 12{com}.     {c )-}
{txt} 13{com}. {c )-}
{txt}
{com}. * Locate the data: the package folder, a qsbs2025_stata_package subfolder, or the current folder
. local found ""
{txt}
{com}. foreach cand in "data/clean" "qsbs2025_stata_package/data/clean" "." {c -(}
{txt}  2{com}.     if "`found'" == "" {c -(}
{txt}  3{com}.         cap confirm file "`cand'/offerings.dta"
{txt}  4{com}.         if _rc == 0 local found "`cand'"
{txt}  5{com}.         else {c -(}
{txt}  6{com}.             cap confirm file "`cand'/offerings.xlsx"
{txt}  7{com}.             if _rc == 0 local found "`cand'"
{txt}  8{com}.         {c )-}
{txt}  9{com}.     {c )-}
{txt} 10{com}. {c )-}
{txt}
{com}. if "`found'" == "" {c -(}
.     di as error "offerings.dta / offerings.xlsx not found in " c(pwd) " (searched data/clean, qsbs2025_stata_package/data/clean and the folder itself)."
.     di as error `"Type   cd "C:\path\to\qsbs2025_stata_package"   and run the do-file again."'
.     exit 601
. {c )-}
{txt}
{com}. global D "`found'"
{txt}
{com}. di as text "data folder: `found'"
{res}{txt}data folder: data/clean

{com}. global T "tables"
{txt}
{com}. global F "figures"
{txt}
{com}. cap mkdir "$T"
{txt}
{com}. cap mkdir "$F"
{txt}
{com}. * user-written packages: offline copies first (folder ado, or ado_offline_update\ado if the
. * update zip was extracted into its own folder), then SSC
. foreach pkg in require ftools reghdfe ppmlhdfe estout coefplot {c -(}
{txt}  2{com}.     cap which `pkg'
{txt}  3{com}.     if _rc != 0 {c -(}
{txt}  4{com}.         di as text "installing `pkg' ..."
{txt}  5{com}.         local done = 0
{txt}  6{com}.         foreach cand in "ado_offline_update/ado" "ado" "qsbs2025_stata_package/ado" {c -(}
{txt}  7{com}.             if `done' == 0 {c -(}
{txt}  8{com}.                 cap confirm file "`cand'/`pkg'/`pkg'.pkg"
{txt}  9{com}.                 if _rc == 0 {c -(}
{txt} 10{com}.                     cap noisily net install `pkg', from("`c(pwd)'/`cand'/`pkg'") replace
{txt} 11{com}.                     if _rc == 0 local done = 1
{txt} 12{com}.                 {c )-}
{txt} 13{com}.             {c )-}
{txt} 14{com}.         {c )-}
{txt} 15{com}.         cap which `pkg'
{txt} 16{com}.         if _rc != 0 cap ssc install `pkg', replace
{txt} 17{com}.     {c )-}
{txt} 18{com}. {c )-}
{txt}
{com}. cap ftools, compile
{txt}
{com}. cap reghdfe, compile
{txt}
{com}. * reghdfe must actually run: version 6 checks for -require- and for ftools >= 2.50
. local upd ""
{txt}
{com}. foreach cand in "ado_offline_update/ado" "ado" "qsbs2025_stata_package/ado" {c -(}
{txt}  2{com}.     if "`upd'" == "" {c -(}
{txt}  3{com}.         cap confirm file "`cand'/require/require.pkg"
{txt}  4{com}.         if _rc == 0 local upd "`cand'"
{txt}  5{com}.     {c )-}
{txt}  6{com}. {c )-}
{txt}
{com}. clear
{txt}
{com}. qui set obs 200
{txt}
{com}. gen double x = rnormal()
{txt}
{com}. gen int g = mod(_n, 10)
{txt}
{com}. gen double y = x + rnormal()
{txt}
{com}. cap noisily reghdfe y x, absorb(g)
{res}{txt}({browse "http://scorreia.com/research/hdfe.pdf":MWFE estimator} converged in 1 iterations)
