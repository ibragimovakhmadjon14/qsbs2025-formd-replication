{com}. * placebo reforms, monthly triple difference (two years before and after)
. use "$D/panel_main_monthly.dta", clear
{txt}
{com}. foreach fm in 2023m7 2024m7 {c -(}
{txt}  2{com}.     preserve
{txt}  3{com}.     keep if ym >= tm(`fm') - 24 & ym < tm(2025m7) & ym <= tm(`fm') + 23
{txt}  4{com}.     gen fpost = ym >= tm(`fm')
{txt}  5{com}.     gen fecp = elig * corp * fpost
{txt}  6{com}.     ppmlhdfe n fecp, absorb(cell elig#ym corp#ym) vce(cluster st_el)
{txt}  7{com}.     addrow R `row' fecp
{txt}  8{com}.     restore
{txt}  9{com}.     local ++row
{txt} 10{com}. {c )-}
