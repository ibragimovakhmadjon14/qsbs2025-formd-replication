{com}. * placebo reforms
. local r = 1
{txt}
{com}. forvalues fq = `=tq(2021q3)'/`=tq(2024q3)' {c -(}
{txt}  2{com}.     foreach w in 3 2 {c -(}
{txt}  3{com}.         if `w' == 3 local M "RI"
{txt}  4{com}.         else local M "RI3"
{txt}  5{com}.         matrix `M'[`r', 1] = `fq'
{txt}  6{com}.         use "$D/panel_corp_quarterly.dta", clear
{txt}  7{com}.         keep if yq >= `fq' - 10 & yq <= `fq' + `w'
{txt}  8{com}.         gen fpost = yq >= `fq'
{txt}  9{com}.         gen fep = elig * fpost
{txt} 10{com}.         cap ppmlhdfe n fep, absorb(cell yq) vce(cluster cell)
{txt} 11{com}.         if _rc == 0 matrix `M'[`r', 2] = _b[fep]
{txt} 12{com}.         use "$D/panel_main_quarterly.dta", clear
{txt} 13{com}.         keep if yq >= `fq' - 10 & yq <= `fq' + `w'
{txt} 14{com}.         gen fpost = yq >= `fq'
{txt} 15{com}.         gen fecp = elig * corp * fpost
{txt} 16{com}.         cap ppmlhdfe n fecp, absorb(cell elig#yq corp#yq) vce(cluster st_el)
{txt} 17{com}.         if _rc == 0 matrix `M'[`r', 3] = _b[fecp]
{txt} 18{com}.         * national series (4 groups x quarter), log counts
.         collapse (sum) n, by(elig corp yq)
{txt} 19{com}.         gen ln_n = ln(n)
{txt} 20{com}.         gen fpost = yq >= `fq'
{txt} 21{com}.         gen fecp = elig * corp * fpost
{txt} 22{com}.         gen fep = elig * fpost
{txt} 23{com}.         gen fcp = corp * fpost
{txt} 24{com}.         egen g = group(elig corp)
{txt} 25{com}.         cap reg ln_n fecp fep fcp i.g i.yq
{txt} 26{com}.         if _rc == 0 matrix `M'[`r', 4] = _b[fecp]
{txt} 27{com}.     {c )-}
{txt} 28{com}.     local ++r
{txt} 29{com}. {c )-}
