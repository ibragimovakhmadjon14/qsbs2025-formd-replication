{com}. use `wk', clear
{txt}
{com}. fillin yr wk group4
{txt}
{com}. replace n = 0 if _fillin
{txt}(0 real changes made)

{com}. drop _fillin
{txt}
{com}. gen treat = group4 == 1
{txt}
{com}. gen y2025 = yr == 2025
{txt}
{com}. gen after = wk >= 0
{txt}
{com}. gen pre3  = inrange(wk, -3, -1)
{txt}
{com}. gen post3 = inrange(wk, 0, 2)
{txt}
{com}. gen yta   = y2025 * treat * after
{txt}
{com}. gen yt    = y2025 * treat
{txt}
{com}. gen ya    = y2025 * after
{txt}
{com}. gen ta    = treat * after
{txt}
{com}. gen ytpre  = y2025 * treat * pre3
{txt}
{com}. gen ytpost = y2025 * treat * post3
{txt}
{com}. gen ypre   = y2025 * pre3
{txt}
{com}. gen ypost  = y2025 * post3
{txt}
{com}. gen wk_id  = wk + 10
{txt}
{com}. gen ln_n   = ln(1 + n)
{txt}
{com}. label var yta "2025 x Eligible C-corp x After 4 July"
{txt}
{com}. label var ytpre "2025 x Eligible C-corp x weeks -3 to -1"
{txt}
{com}. label var ytpost "2025 x Eligible C-corp x weeks 0 to 2"
{txt}
{com}. label var ya "2025 x After 4 July"
{txt}
{com}. label var ypre "2025 x weeks -3 to -1"
{txt}
{com}. label var ypost "2025 x weeks 0 to 2"
{txt}
{com}. save "$D/retiming_weekly.dta", replace
