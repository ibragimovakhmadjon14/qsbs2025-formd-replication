. use "$D/panel_main_monthly.dta", clear
{txt}
{com}. egen st = group(state)
{txt}
{com}. matrix V = J(4, 3, .)
{txt}
{com}. matrix colnames V = b se p
{txt}
{com}. local i = 1
{txt}
{com}. foreach vc in "robust" "cluster st_el" "cluster st" "cluster cell" {c -(}
{txt}  2{com}.     ppmlhdfe n ecp, absorb(cell elig#ym corp#ym) vce(`vc')
{txt}  3{com}.     matrix V[`i', 1] = _b[ecp]
{txt}  4{com}.     matrix V[`i', 2] = _se[ecp]
{txt}  5{com}.     matrix V[`i', 3] = 2 * normal(-abs(_b[ecp] / _se[ecp]))
{txt}  6{com}.     local ++i
{txt}  7{com}. {c )-}
