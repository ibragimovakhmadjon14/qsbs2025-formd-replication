{txt}
{com}. scalar chk_ddd_se = _se[ecp]
{txt}
{com}. * national series (4 groups x quarter, ln counts), same window, OLS and Newey-West (HAC) errors
. * computed within each group's series (tsset g yq); the paper reports the two-lag version
. collapse (sum) n, by(elig corp yq)
{res}{txt}
{com}. keep if yq >= tq(2025q3) - 10 & yq <= tq(2025q3) + 2
{txt}(64 observations deleted)

{com}. gen ln_n  = ln(n)
{txt}
{com}. gen npost = yq >= tq(2025q3)
{txt}
{com}. gen necp  = elig * corp * npost
{txt}
{com}. gen nep   = elig * npost
{txt}
{com}. gen ncp   = corp * npost
{txt}
{com}. egen g = group(elig corp)
{txt}
