{com}. foreach M in RI RI4 {c -(}
{txt}  2{com}.     preserve
{txt}  3{com}.     clear
{txt}  4{com}.     qui set obs 13
{txt}  5{com}.     svmat `M', names(col)
{txt}  6{com}.     format quarter %tq
{txt}  7{com}.     if "`M'" == "RI" export delimited using "$T/tab8_panelA_ri_placebos.csv", replace
{txt}  8{com}.     else export delimited using "$T/tab8_panelA_ri_placebos_4post.csv", replace
{txt}  9{com}.     if "`M'" == "RI" di as result _n "Placebo-in-time distributions, three post-reform quarters (as in the paper):"
{txt} 10{com}.     else di as result _n "For comparison only - four post-reform quarters (September version):"
{txt} 11{com}.     foreach v in b_primary b_ddd b_national {c -(}
{txt} 12{com}.         if "`v'" == "b_primary"  local act = `b_prim'
{txt} 13{com}.         if "`v'" == "b_ddd"      local act = `b_ddd'
{txt} 14{com}.         if "`v'" == "b_national" local act = `b_nat'
{txt} 15{com}.         qui count if abs(`v') >= abs(`act') & `v' < .
{txt} 16{com}.         local nge = r(N)
{txt} 17{com}.         qui count if `v' < .
{txt} 18{com}.         local p = `nge' / r(N)
{txt} 19{com}.         qui sum `v'
{txt} 20{com}.         di as result "  `v': actual " %7.3f `act' "; placebos mean " %6.3f r(mean) ", sd " %6.3f r(sd) ///
>             ", range " %6.3f r(min) " to " %6.3f r(max) "; share |placebo| >= |actual| " %4.2f `p'
{txt} 21{com}.     {c )-}
{txt} 22{com}.     if "`M'" == "RI" {c -(}
{txt} 23{com}.         di as result "  paper, Table 8: primary +0.071; 0.051; +0.003 to +0.182; 0.77 | triple difference +0.250; 0.257;"
{txt} 24{com}.         di as result "                 -0.079 to +0.688; 0.31 | national series +0.242; 0.251; -0.096 to +0.676; 0.31"
{txt} 25{com}.         * Figure A3: placebo distributions (frequencies, whole-number ticks)
.         foreach v in b_primary b_ddd {c -(}
{txt} 26{com}.             qui sum `v'
{txt} 27{com}.             local lo = r(min)
{txt} 28{com}.             local wd = (r(max) - r(min)) / 8
{txt} 29{com}.             gen _bin = min(floor((`v' - `lo') / `wd'), 7) if `v' < .
{txt} 30{com}.             bys _bin: gen _cnt = _N if _bin < .
{txt} 31{com}.             qui sum _cnt
{txt} 32{com}.             local ymax_`v' = r(max)
{txt} 33{com}.             if "`ymax_`v''" == "." local ymax_`v' = 1
{txt} 34{com}.             drop _bin _cnt
{txt} 35{com}.         {c )-}
{txt} 36{com}.         twoway (histogram b_primary, frequency bin(8) fcolor(gs12) lcolor(gs6)), xline(`b_prim', lcolor(black) lwidth(thick)) ///
>             xline(0, lpattern(dash) lcolor(gs8)) ylabel(0(1)`ymax_b_primary') ///
>             xtitle("Placebo-reform coefficient, primary design") ytitle("Number of placebo reforms") name(hA, replace)
{txt} 37{com}.         twoway (histogram b_ddd, frequency bin(8) fcolor(gs12) lcolor(gs6)), xline(`b_ddd', lcolor(black) lwidth(thick)) ///
>             xline(0, lpattern(dash) lcolor(gs8)) ylabel(0(1)`ymax_b_ddd') ///
>             xtitle("Placebo-reform coefficient, quarterly triple difference") ytitle("Number of placebo reforms") name(hB, replace)
{txt} 38{com}.         graph combine hA hB, rows(1)
{txt} 39{com}.         graph export "$F/figA3_placebo_distribution.png", replace width(2400)
{txt} 40{com}.     {c )-}
{txt} 41{com}.     restore
{txt} 42{com}. {c )-}
