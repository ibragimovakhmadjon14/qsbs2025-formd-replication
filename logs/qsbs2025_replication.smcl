* = FE nested within cluster; treated as redundant for DoF computation
{res}{txt}
{com}. * placebo reforms, amounts, C-corps vs all other C-corps
. use "$D/analysis_sample.dta", clear
{txt}
{com}. foreach fq in 2023q3 2024q3 {c -(}
{txt}  2{com}.     preserve
{txt}  3{com}.     keep if corp == 1 & ln_sold_orig < . & yq >= tq(`fq') - 8 & yq <= tq(`fq') + 3 & yq < tq(2025q3)
{txt}  4{com}.     gen fpost = yq >= tq(`fq')
{txt}  5{com}.     gen fep = elig * fpost
{txt}  6{com}.     reghdfe ln_sold_orig fep, absorb(st_gr ym) vce(cluster st_gr)
{txt}  7{com}.     addrow R `row' fep
{txt}  8{com}.     restore
{txt}  9{com}.     local ++row
{txt} 10{com}. {c )-}
