>         xtitle("") ytitle("Original notices per quarter") xlabel(`=tq(2019q1)'(4)`=tq(2026q1)', angle(45)) ///
>         name(sc_path, replace) nodraw
.     twoway `gl' (line gap_tr yq, lcolor(black) lwidth(thick)), ///
