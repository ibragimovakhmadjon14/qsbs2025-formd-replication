{com}. if _rc != 0 & "`upd'" != "" {c -(}
.     di as text "reghdfe did not run; reinstalling require, ftools, reghdfe and ppmlhdfe from `upd'"
.     foreach pkg in require ftools reghdfe ppmlhdfe {c -(}
{txt}  2{com}.         cap noisily net install `pkg', from("`c(pwd)'/`upd'/`pkg'") replace
{txt}  3{com}.     {c )-}
.     discard
.     cap ftools, compile
