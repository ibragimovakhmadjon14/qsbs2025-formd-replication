. *------------------------------------------------------------------------------*
. * 1. Analysis sample and variables (mirrors prep.py)
. *------------------------------------------------------------------------------*
. di as result _n "===== SECTION 1. Analysis sample and variables (mirrors prep.py) ====="
{res}
===== SECTION 1. Analysis sample and variables (mirrors prep.py) =====
{txt}
{com}. * Data: either data/clean/offerings.dta or data/clean/offerings.xlsx (same variables; dates in the
. * Excel file are text "YYYY-MM-DD" and are converted below)
. cap confirm file "$D/offerings.dta"
{txt}
{com}. if _rc == 0 {c -(}
.     use "$D/offerings.dta", clear
. {c )-}
{txt}
{com}. else {c -(}
.     cap confirm file "$D/offerings.xlsx"
.     if _rc != 0 {c -(}
.         di as error "Neither data/clean/offerings.dta nor data/clean/offerings.xlsx found. Type -pwd-: the working directory must be the unzipped package folder."
.         exit 601
.     {c )-}
.     import excel "$D/offerings.xlsx", sheet("offerings") firstrow clear
.     foreach v in filing_date sale_date event_date {c -(}
{txt}  2{com}.         cap confirm string variable `v'
{txt}  3{com}.         if _rc == 0 {c -(}
{txt}  4{com}.             gen double `v'_d = date(`v', "YMD")
{txt}  5{com}.             drop `v'
{txt}  6{com}.             rename `v'_d `v'
{txt}  7{com}.         {c )-}
{txt}  8{com}.         else {c -(}
{txt}  9{com}.             local f : format `v'
{txt} 10{com}.             if strpos("`f'", "tc") > 0 replace `v' = dofc(`v')
{txt} 11{com}.         {c )-}
{txt} 12{com}.         format `v' %td
{txt} 13{com}.     {c )-}
.     * make sure the numeric fields did not arrive as strings
.     foreach v in in_sample sale_date_missing amount_sold amount_sold_180d n_investors n_investors_180d ///
>                  min_investment offering_amount round_no first_formd priced_equity safe_flag convertible_flag ///
>                  sec_equity sec_debt sec_other rule506b rule506c rule504 inc_within_5y inc_year delaware_inc ///
>                  ai_name_flag is_fund bus_combination {c -(}
{txt}  2{com}.         cap confirm string variable `v'
{txt}  3{com}.         if _rc == 0 destring `v', replace force
{txt}  4{com}.     {c )-}
.     foreach v in accessionnumber cik state qsbs_group industry_raw entity rev_range {c -(}
{txt}  2{com}.         cap confirm numeric variable `v'
{txt}  3{com}.         if _rc == 0 tostring `v', replace
{txt}  4{com}.     {c )-}
. {c )-}
{txt}
{com}. keep if in_sample == 1
{txt}(0 observations deleted)

{com}. keep if inlist(qsbs_group, "eligible", "excluded", "ambiguous")
{txt}(0 observations deleted)

{com}. format event_date %td
{txt}
{com}. 
. * end of data = last filing date; drop the 15-day filing-lag tail and date typos
. qui sum filing_date
{txt}
{com}. local data_end = r(max)
{txt}
{com}. local lastday  = `data_end' - 15
{txt}
{com}. drop if event_date > `lastday'
{txt}(219 observations deleted)

{com}. di as text "filings end " %td `data_end' ", sample ends " %td `lastday'
{res}{txt}filings end 30sep2026, sample ends 15sep2026

{com}. 
. gen reform = td(04jul2025)
{txt}
{com}. gen post   = event_date > reform
{txt}
{com}. gen elig   = qsbs_group == "eligible"
{txt}
{com}. gen ambig  = qsbs_group == "ambiguous"
{txt}
{com}. gen corp   = entity == "corp"
{txt}
{com}. gen ym     = mofd(event_date)
{txt}
{com}. gen yq     = qofd(event_date)
{txt}
{com}. gen year   = yofd(event_date)
{txt}
{com}. format ym %tm
{txt}
{com}. format yq %tq
{txt}
{com}. 
. gen ln_sold      = ln(amount_sold_180d) if amount_sold_180d > 0
{txt}(16,723 missing values generated)

{com}. gen ln_sold_orig = ln(amount_sold)      if amount_sold > 0
{txt}(17,381 missing values generated)

{com}. gen ln_inv       = ln(1 + n_investors_180d)
{txt}
{com}. gen ln_minin     = ln(1 + min_investment)
{txt}
{com}. gen big_round    = amount_sold_180d >= 10e6 if amount_sold_180d < .
{txt}
{com}. gen repeat       = round_no > 1
{txt}
{com}. * Revenue above USD 5 million (H3; Table 5, columns 3-4), the cut-off of the published
. * estimates. The Form D revenue ranges are 1 - 1,000,000 / 1,000,001 - 5,000,000 /
. * 5,000,001 - 25,000,000 / 25,000,001 - 100,000,000 / Over 100,000,000 / No Revenues /
. * Decline to Disclose / Not Applicable. "5,000,001" matches the ranges 5,000,001 - 25,000,000
. * and 25,000,001 - 100,000,000; "over" matches Over 100,000,000.
. gen late_rev     = (strpos(rev_range, "5,000,001") > 0 | strpos(rev_range, "5000001") > 0 | ///
>                     strpos(lower(rev_range), "over") > 0)
{txt}
{com}. * revenue above USD 25 million: used only for a sensitivity check printed after Table 5
. gen rev25        = (strpos(rev_range, "25,000,001") > 0 | strpos(rev_range, "25000001") > 0 | ///
>                     strpos(lower(rev_range), "over") > 0)
{txt}
{com}. gen safe_or_note = (safe_flag == 1 | convertible_flag == 1)
{txt}
{com}. gen amount_m     = amount_sold / 1e6
{txt}
{com}. 
. gen group4 = 1 if elig == 1 & corp == 1
{txt}(74,611 missing values generated)

{com}. replace group4 = 2 if elig == 0 & corp == 1 & ambig == 0
{txt}(4,069 real changes made)

{com}. replace group4 = 3 if elig == 1 & corp == 0
{txt}(5,096 real changes made)

{com}. replace group4 = 4 if elig == 0 & corp == 0 & ambig == 0
{txt}(6,522 real changes made)

{com}. label define group4 1 "Eligible C-corps" 2 "Excluded C-corps" 3 "Eligible LLCs" 4 "Excluded LLCs"
{txt}
{com}. label values group4 group4
{txt}
