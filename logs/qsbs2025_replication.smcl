. *------------------------------------------------------------------------------*
. * 6. Quarterly event studies (Figures 2, 4, A1) - reference period 2024
. *------------------------------------------------------------------------------*
. di as result _n "===== SECTION 6. Quarterly event studies (Figures 2, 4, A1) - reference period 2024 ====="
{res}
===== SECTION 6. Quarterly event studies (Figures 2, 4, A1) - reference period 2024 =====
{txt}
{com}. cap program drop qes
{txt}
{com}. program define qes
{txt}  1{com}.     * qes depvar treatvar [if], absorb() cluster() file() ytitle() [ols last(quarter, default 2026q1)]
.     syntax varlist(min=2 max=2) [if], absorb(string) cluster(string) file(string) ytitle(string) [ols last(string)]
{txt}  2{com}.     tokenize `varlist'
{txt}  3{com}.     local dep `1'
{txt}  4{com}.     local trt `2'
{txt}  5{com}.     if "`last'" == "" local last "2026q1"
{txt}  6{com}.     local qa = tq(2023q1)
{txt}  7{com}.     local qb = tq(`last')
{txt}  8{com}.     local nq = `qb' - `qa' + 1
{txt}  9{com}.     preserve
{txt} 10{com}.     if `"`if'"' != "" keep `if'
{txt} 11{com}.     keep if yq >= `qa' & yq <= `qb'
{txt} 12{com}.     local names ""
{txt} 13{com}.     forvalues q = `qa'/`qb' {c -(}
{txt} 14{com}.         if `q' >= tq(2024q1) & `q' <= tq(2024q4) continue
{txt} 15{com}.         gen Q_`q' = (yq == `q') * `trt'
{txt} 16{com}.         local names "`names' Q_`q'"
{txt} 17{com}.     {c )-}
{txt} 18{com}.     if "`ols'" == "" ppmlhdfe `dep' `names', absorb(`absorb') vce(cluster `cluster')
{txt} 19{com}.     else reghdfe `dep' `names', absorb(`absorb') vce(cluster `cluster')
{txt} 20{com}.     tempname B
{txt} 21{com}.     matrix `B' = J(`nq', 4, .)
{txt} 22{com}.     local r = 1
{txt} 23{com}.     forvalues q = `qa'/`qb' {c -(}
{txt} 24{com}.         matrix `B'[`r', 1] = `q'
{txt} 25{com}.         if `q' >= tq(2024q1) & `q' <= tq(2024q4) {c -(}
{txt} 26{com}.             matrix `B'[`r', 2] = 0
{txt} 27{com}.             matrix `B'[`r', 3] = 0
{txt} 28{com}.             matrix `B'[`r', 4] = 0
{txt} 29{com}.         {c )-}
{txt} 30{com}.         else {c -(}
{txt} 31{com}.             cap matrix `B'[`r', 2] = _b[Q_`q']
{txt} 32{com}.             cap matrix `B'[`r', 3] = _b[Q_`q'] - 1.96 * _se[Q_`q']
{txt} 33{com}.             cap matrix `B'[`r', 4] = _b[Q_`q'] + 1.96 * _se[Q_`q']
{txt} 34{com}.         {c )-}
{txt} 35{com}.         local ++r
{txt} 36{com}.     {c )-}
{txt} 37{com}.     clear
{txt} 38{com}.     qui set obs `nq'
{txt} 39{com}.     svmat `B', names(col)
{txt} 40{com}.     rename (c1 c2 c3 c4) (yq b lo hi)
{txt} 41{com}.     format yq %tq
{txt} 42{com}.     export delimited using "$T/`file'.csv", replace
{txt} 43{com}.     twoway (rcap lo hi yq, lcolor(gs8)) (connected b yq, lcolor(black) mcolor(black) msymbol(O) msize(small)), ///
>         yline(0, lpattern(dash) lcolor(gs8)) xline(`=tq(2025q3) - 0.5', lpattern(dot) lcolor(gs8)) ///
>         xtitle("") ytitle("`ytitle'") xlabel(`qa'(1)`qb', angle(45) format(%tq)) legend(off)
{txt} 44{com}.     graph export "$F/`file'.png", replace width(2400)
{txt} 45{com}.     restore
{txt} 46{com}. end
{txt}
{com}. 
