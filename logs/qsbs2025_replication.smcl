===== SECTION 11. Figure 5 and Table 7: retiming of first sales around 4 July =====
{txt}
{com}. use "$D/analysis_sample.dta", clear
{txt}
{com}. keep if ambig == 0
{txt}(57,156 observations deleted)

{com}. tempfile wk
{txt}
{com}. local first = 1
{txt}
{com}. forvalues y = 2019/2025 {c -(}
{txt}  2{com}.     preserve
{txt}  3{com}.     local anchor = mdy(7, 4, `y')
{txt}  4{com}.     keep if inrange(event_date, `anchor' - 63, `anchor' + 62)
{txt}  5{com}.     gen rel_day = event_date - `anchor'
{txt}  6{com}.     gen wk = floor(rel_day / 7)
{txt}  7{com}.     gen yr = `y'
{txt}  8{com}.     gen one = 1
{txt}  9{com}.     * four groups (eligible C-corporations and the three control groups of the main sample):
.     * 7 years x 18 weeks x 4 groups = 504 cells, as in Table 7
.     collapse (sum) n = one, by(yr wk group4)
{txt} 10{com}.     if `first' == 1 {c -(}
{txt} 11{com}.         save `wk', replace
{txt} 12{com}.         local first = 0
{txt} 13{com}.     {c )-}
{txt} 14{com}.     else {c -(}
{txt} 15{com}.         append using `wk'
{txt} 16{com}.         save `wk', replace
{txt} 17{com}.     {c )-}
{txt} 18{com}.     restore
{txt} 19{com}. {c )-}
