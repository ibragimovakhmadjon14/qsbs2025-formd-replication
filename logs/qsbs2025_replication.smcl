>     title("Table A6. Sensitivity of the monthly triple-difference count estimate to the variance estimator")
{res}{txt}(output written to {browse  `"tables/tabA6_variance.rtf"'})

{com}. * CSV copy of the same table (opens in Excel):
. esttab matrix(V, fmt(4 3 2)) using "$T/tabA6_variance.csv", replace ///
>     title("Table A6. Sensitivity of the monthly triple-difference count estimate to the variance estimator")
{res}{txt}(output written to {browse  `"tables/tabA6_variance.csv"'})

{com}. 
. * Figure A2: monthly event study, LLCs only, eligible vs excluded, reference 2024
. use "$D/panel_main_monthly.dta", clear
{txt}
{com}. keep if corp == 0 & ym >= tm(2023m1)
{txt}(13,974 observations deleted)

{com}. local names ""
{txt}
{com}. forvalues m = `=tm(2023m1)'/`=tm(2026m5)' {c -(}
{txt}  2{com}.     if `m' >= tm(2024m1) & `m' <= tm(2024m12) continue
{txt}  3{com}.     gen M_`m' = (ym == `m') * elig
{txt}  4{com}.     local names "`names' M_`m'"
{txt}  5{com}. {c )-}
{txt}
{com}. ppmlhdfe n `names', absorb(cell ym) vce(cluster st_el)
{res}{txt}(dropped 41 observations that are either {browse "http://scorreia.com/research/singletons.pdf":singletons} or {browse "http://scorreia.com/research/separation.pdf":separated} by a fixed effect)
